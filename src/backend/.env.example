# ============================================
# Codeforces Calendar Backend Configuration
# ============================================

# Environment: development, staging, or production
NODE_ENV=development

# ============================================
# MongoDB Configuration
# ============================================

# DEVELOPMENT (Local Docker)
# Use this for local development with docker-compose
MONGO_URL=mongodb://mongo:27017/codeforces-calendar

# DEVELOPMENT (Local Manual)
# Use this if running MongoDB locally without Docker
# MONGO_URL=mongodb://localhost:27017/codeforces-calendar

# STAGING (HuggingFace Spaces / MongoDB Atlas Free Tier)
# Get free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas/register
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/codeforces-calendar-staging

# PRODUCTION (MongoDB Atlas / Google Cloud Run)
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/codeforces-calendar

# ============================================
# Server Configuration
# ============================================

API_PORT=4000

# ============================================
# CORS Configuration
# ============================================

# DEVELOPMENT: Allow all origins
CORS_ORIGIN=*

# STAGING: Specific extension ID or domain
# CORS_ORIGIN=chrome-extension://YOUR_STAGING_EXTENSION_ID

# PRODUCTION: Specific extension ID
# CORS_ORIGIN=chrome-extension://kdpcekneldcnkajbmabmfgdpcdjdmcfd

# ============================================
# Cron Job Configuration
# ============================================

ENABLE_CRON=true

